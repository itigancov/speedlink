{
  "name": "speedlink",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "biome ci --error-on-warnings . && wxt prepare && tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare && (git config core.hooksPath .githooks || true)"
  },
  "dependencies": {
    "@webext-core/messaging": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/i18n": "0.2.8",
    "@wxt-dev/module-react": "1.2.2",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
}
